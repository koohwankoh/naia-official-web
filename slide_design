<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NAIA 슬라이드 · 인포그래픽 디자인 스튜디오 (952 프롬프트)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&family=Noto+Serif+KR:wght@400;600;700&display=swap" rel="stylesheet">
<style>

  :root {
    --bg: #f5f5f7;
    --surface: #ffffff;
    --surface2: #fbfbfd;
    --border: rgba(0,0,0,0.08);
    --text-primary: #1d1d1f;
    --text-secondary: #6e6e73;
    --text-tertiary: #a1a1a6;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --accent-light: #e8f0fe;
    --sidebar-bg: #f5f5f7;
    --sidebar-width: 280px;
    --radius: 12px;
    --radius-lg: 18px;
    --shadow: 0 2px 20px rgba(0,0,0,0.08);
    --shadow-lg: 0 8px 40px rgba(0,0,0,0.12);
    --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── TOP NAV ── */
  .topnav {
    height: 52px;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 24px;
    gap: 12px;
    position: relative;
    z-index: 100;
    flex-shrink: 0;
  }
  .topnav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-icon {
    width: 28px; height: 28px;
    background: linear-gradient(135deg, #0071e3, #34aadc);
    border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .topnav h1 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.3px;
  }
  .topnav-sub {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-left: 4px;
  }
  .topnav-stats {
    margin-left: auto;
    display: flex;
    gap: 20px;
  }
  .stat-chip {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--text-secondary);
  }
  .stat-chip span { font-weight: 600; color: var(--text-primary); }
  .vip-badge {
    background: linear-gradient(135deg, rgba(0,113,227,0.10), rgba(52,170,220,0.10));
    border: 1px solid rgba(0,113,227,0.25);
    border-radius: 20px;
    padding: 3px 12px;
    color: var(--accent) !important;
    font-weight: 500;
    font-size: 12px;
    display: flex; align-items: center; gap: 4px;
  }
  .vip-badge span { color: var(--accent) !important; font-weight: 700; }
  .vip-badge .total { font-size: 13px; font-weight: 800; }

  /* ── MAIN LAYOUT ── */
  .app-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    width: var(--sidebar-width);
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
  }
  .sidebar-header {
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sidebar-title-row {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .sidebar-search-icon {
    width: 28px; height: 28px;
    border-radius: 7px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-tertiary);
    transition: background var(--transition), color var(--transition);
    flex-shrink: 0;
    padding: 0;
  }
  .sidebar-search-icon:hover { background: rgba(0,0,0,0.06); color: var(--accent); }
  .sidebar-search-icon.active { color: var(--accent); background: rgba(0,113,227,0.08); }
  .sidebar-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    flex: 1;
    text-align: center;
  }

  /* ── SEARCH BAR ── */
  .search-bar-wrap {
    display: none;
    position: relative;
  }
  .search-bar-wrap.open { display: block; }
  .search-bar-wrap input {
    width: 100%;
    height: 34px;
    border: 1.5px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    padding: 0 34px 0 12px;
    font-size: 13px;
    font-family: 'Noto Sans KR', sans-serif;
    color: var(--text-primary);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .search-bar-wrap input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0,113,227,0.10);
  }
  .search-bar-wrap input::placeholder { color: var(--text-tertiary); }
  .search-clear-btn {
    position: absolute;
    right: 8px; top: 50%;
    transform: translateY(-50%);
    background: none; border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    font-size: 14px;
    line-height: 1;
    display: none;
    padding: 2px 4px;
    border-radius: 4px;
  }
  .search-clear-btn:hover { color: var(--text-primary); background: rgba(0,0,0,0.05); }
  .search-clear-btn.visible { display: block; }

  /* ── SEARCH RESULTS ── */
  .search-results-list {
    display: none;
    flex-direction: column;
    overflow-y: auto;
    flex: 1;
    padding: 6px 0;
  }
  .search-results-list.open { display: flex; }
  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 16px;
    cursor: pointer;
    border: none;
    background: none;
    text-align: left;
    font-family: 'Noto Sans KR', sans-serif;
    transition: background var(--transition);
  }
  .search-result-item:hover { background: rgba(0,0,0,0.04); }
  .search-result-item.active { background: rgba(0,113,227,0.06); }
  .sri-industry {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .search-result-item.active .sri-industry { color: var(--accent); }
  .sri-category {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .sri-highlight {
    background: rgba(0,113,227,0.13);
    color: var(--accent);
    border-radius: 3px;
    padding: 0 1px;
  }
  .search-no-result {
    padding: 24px 20px;
    text-align: center;
    font-size: 13px;
    color: var(--text-tertiary);
  }
  .sidebar-scroll {
    overflow-y: auto;
    flex: 1;
    padding: 8px 0;
  }
  .sidebar-scroll::-webkit-scrollbar { width: 4px; }
  .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
  .sidebar-scroll::-webkit-scrollbar-thumb { background: #d0d0d5; border-radius: 2px; }

  .category-group { margin-bottom: 2px; }
  .category-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    border-radius: 0;
    transition: background var(--transition);
    color: var(--text-primary);
  }
  .category-btn:hover { background: rgba(0,0,0,0.04); }
  .category-btn.active { background: rgba(0,113,227,0.08); }
  .cat-emoji { font-size: 18px; flex-shrink: 0; width: 24px; text-align: center; }
  .cat-info { flex: 1; min-width: 0; }
  .cat-name {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-primary);
    display: block;
    line-height: 1.3;
  }
  .cat-count {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .category-btn.active .cat-name { color: var(--accent); font-weight: 600; }
  .cat-chevron {
    font-size: 10px;
    color: var(--text-tertiary);
    transition: transform var(--transition);
    flex-shrink: 0;
  }
  .category-btn.active .cat-chevron { transform: rotate(90deg); color: var(--accent); }

  .industry-list {
    display: none;
    background: rgba(0,0,0,0.02);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 2px;
  }
  .industry-list.open { display: block; }
  .industry-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px 9px 54px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: 13px;
    color: var(--text-secondary);
    transition: all var(--transition);
    font-family: 'Noto Sans KR', sans-serif;
  }
  .industry-btn:hover { background: rgba(0,0,0,0.04); color: var(--text-primary); }
  .industry-btn.active {
    background: rgba(0,113,227,0.06);
    color: var(--accent);
    font-weight: 600;
  }
  .industry-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--text-tertiary);
    flex-shrink: 0;
  }
  .industry-btn.active .industry-dot { background: var(--accent); }

  /* ── CONTENT AREA ── */
  .content-area {
    flex: 1;
    overflow-y: auto;
    background: var(--bg);
    padding: 32px;
  }
  .content-area::-webkit-scrollbar { width: 6px; }
  .content-area::-webkit-scrollbar-track { background: transparent; }
  .content-area::-webkit-scrollbar-thumb { background: #c7c7cc; border-radius: 3px; }

  /* Welcome screen */
  .welcome-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    animation: fadeIn 0.4s ease;
  }
  .welcome-icon {
    width: 80px; height: 80px;
    background: linear-gradient(135deg, #0071e3, #34aadc);
    border-radius: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 36px;
    margin-bottom: 24px;
    box-shadow: 0 8px 32px rgba(0,113,227,0.25);
  }
  .welcome-screen h2 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }
  .welcome-screen p {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 420px;
    line-height: 1.6;
  }
  .welcome-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 32px;
    max-width: 480px;
  }
  .welcome-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    text-align: center;
  }
  .welcome-chip .num { font-size: 22px; font-weight: 700; color: var(--accent); }
  .welcome-chip .lbl { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
  .welcome-chip.vip-chip {
    background: linear-gradient(135deg, rgba(0,113,227,0.07), rgba(52,170,220,0.07));
    border: 1px solid rgba(0,113,227,0.20);
  }
  .welcome-chip.vip-chip .num { color: var(--accent); }
  .welcome-chip.total-chip {
    background: linear-gradient(135deg, rgba(0,113,227,0.12), rgba(52,170,220,0.12));
    border: 1.5px solid rgba(0,113,227,0.35);
  }
  .welcome-chip.total-chip .num { font-size: 26px; color: var(--accent); }
  .welcome-chip.total-chip .lbl { font-weight: 600; color: var(--accent); }

  /* Sidebar footer */
  .sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .made-by-coda {
    flex: 1;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
    color: #b0b0b8;
    text-decoration: none;
    letter-spacing: 0.3px;
    padding: 6px 8px;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }
  .made-by-coda:hover {
    color: var(--accent);
    background: rgba(0,113,227,0.07);
  }
  .vip-popup-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    background: linear-gradient(135deg, #0071e3, #34aadc);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.3px;
    transition: opacity 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0,113,227,0.30);
  }
  .vip-popup-btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .vip-popup-btn:active { transform: translateY(0); }

  /* VIP Popup Overlay */
  .vip-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 9000;
    align-items: center;
    justify-content: center;
  }
  .vip-overlay.open { display: flex; }
  .vip-modal {
    background: #ffffff;
    border-radius: 22px;
    width: 520px;
    max-width: 92vw;
    padding: 36px 36px 32px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.22), 0 0 0 1px rgba(0,0,0,0.06);
    position: relative;
    animation: slideUp 0.28s cubic-bezier(0.34,1.56,0.64,1);
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .vip-modal-close {
    position: absolute;
    top: 18px; right: 20px;
    width: 30px; height: 30px;
    border-radius: 50%;
    border: none;
    background: #f0f0f5;
    color: #6e6e73;
    font-size: 16px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
  }
  .vip-modal-close:hover { background: #e0e0e8; color: #1d1d1f; }
  .vip-modal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #0071e3, #34aadc);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .vip-modal h3 {
    font-size: 22px;
    font-weight: 800;
    color: #1d1d1f;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .vip-modal-sub {
    font-size: 13px;
    color: #6e6e73;
    margin-bottom: 26px;
    line-height: 1.5;
  }
  .vip-btn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .vip-cat-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 18px 16px 16px;
    border-radius: 14px;
    border: 1px solid #e5e5ea;
    cursor: pointer;
    text-align: left;
    position: relative;
    overflow: hidden;
    background: #fafafa;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }
  .vip-cat-btn:hover {
    background: #f0f0f5;
    border-color: #d0d0d8;
    transform: translateY(-1px);
  }
  .vip-cat-btn:active { transform: translateY(0); background: #e8e8ee; }
  .vib-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .vib-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: #efefef;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .vib-count-wrap {
    background: #ebebeb;
    border-radius: 20px;
    padding: 2px 10px;
  }
  .vib-count { font-size: 11px; font-weight: 700; color: #3a3a3c; }
  .vib-title { font-size: 13px; font-weight: 700; color: #1d1d1f; line-height: 1.3; }
  .vib-desc { font-size: 11px; color: #8e8e93; line-height: 1.45; }
  .vip-modal-footer { margin-top: 20px; text-align: center; font-size: 11.5px; color: #aeaeb2; }

  /* Prompt display */
  .prompt-header {
    margin-bottom: 28px;
    animation: fadeInUp 0.35s ease;
  }
  .prompt-header-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .ph-category {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-tertiary);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 10px;
  }
  .ph-arrow { color: var(--text-tertiary); font-size: 12px; }
  .ph-industry {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-light);
    border-radius: 6px;
    padding: 3px 10px;
  }
  .prompt-header h2 {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .prompt-header p { font-size: 14px; color: var(--text-secondary); }

  /* Prompt grid */
  .prompt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
  }

  .prompt-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition);
    animation: fadeInUp 0.4s ease both;
    position: relative;
  }
  .prompt-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(0,113,227,0.15);
  }
  .prompt-card:nth-child(1) { animation-delay: 0.05s; }
  .prompt-card:nth-child(2) { animation-delay: 0.1s; }
  .prompt-card:nth-child(3) { animation-delay: 0.15s; }
  .prompt-card:nth-child(4) { animation-delay: 0.2s; }
  .prompt-card:nth-child(5) { animation-delay: 0.25s; }
  .prompt-card:nth-child(6) { animation-delay: 0.3s; }
  .prompt-card:nth-child(7) { animation-delay: 0.35s; }

  .card-top {
    padding: 16px 18px 14px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-bottom: 1px solid var(--border);
  }
  .card-num {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .card-title-block { flex: 1; }
  .card-design-name {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 3px;
    letter-spacing: -0.2px;
  }
  .card-design-type {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .card-body {
    padding: 14px 18px 16px;
  }
  .prompt-text {
    font-size: 11.5px;
    line-height: 1.75;
    color: var(--text-secondary);
    font-family: 'SF Mono', 'Menlo', monospace;
    white-space: pre-wrap;
    word-break: break-word;
    background: #f9f9fb;
    border-radius: 8px;
    padding: 12px 14px;
    border: 1px solid rgba(0,0,0,0.05);
    max-height: 280px;
    overflow-y: auto;
  }
  .prompt-text::-webkit-scrollbar { width: 3px; }
  .prompt-text::-webkit-scrollbar-thumb { background: #d0d0d5; border-radius: 2px; }
  .card-footer {
    padding: 10px 18px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .color-swatches {
    display: flex;
    gap: 5px;
  }
  .swatch {
    width: 21px; height: 21px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.85);
    box-shadow: 0 1px 4px rgba(0,0,0,0.25);
  }
  .copy-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 7px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
    font-family: 'Noto Sans KR', sans-serif;
  }
  .copy-btn:hover { background: var(--accent-hover); transform: scale(1.03); }
  .copy-btn.copied { background: #34c759; }
  .copy-btn svg { width: 12px; height: 12px; }

  .infog-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: linear-gradient(135deg, #ff6b35, #f7931e);
