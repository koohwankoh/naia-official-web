function rgbToHex(r, g, b) {
  return '#' + [r, g, b].map(x => Math.max(0, Math.min(255, Math.round(x))).toString(16).padStart(2, '0')).join('').toUpperCase();
}

function handleBgUpload(file) {
  if (!file || !file.type.startsWith('image/')) {
    showToast('이미지 파일(PNG, JPG, WEBP)을 선택해 주세요.');
    return;
  }
  const reader = new FileReader();
  reader.onload = function(ev) {
    const img = new Image();
    img.onload = function() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const w = 48, h = 48;
      canvas.width = w; canvas.height = h;
      ctx.drawImage(img, 0, 0, w, h);
      const data = ctx.getImageData(0, 0, w, h).data;

      let rSum = 0, gSum = 0, bSum = 0, count = 0;
      let maxSat = -1, accR = 37, accG = 99, accB = 235;
      for (let i = 0; i < data.length; i += 4) {
        const r = data[i], g = data[i+1], b = data[i+2], a = data[i+3];
        if (a < 128) continue;
        rSum += r; gSum += g; bSum += b; count++;
        const maxC = Math.max(r, g, b), minC = Math.min(r, g, b);
        const sat = maxC === 0 ? 0 : (maxC - minC) / maxC;
        const lum = (0.299*r + 0.587*g + 0.114*b);
        if (sat > maxSat && lum > 45 && lum < 225) {
          maxSat = sat; accR = r; accG = g; accB = b;
        }
      }
      const avgR = count ? rSum / count : 248;
      const avgG = count ? gSum / count : 250;
      const avgB = count ? bSum / count : 252;
      const bgHex = rgbToHex(avgR, avgG, avgB);
      const bgLum = 0.299 * avgR + 0.587 * avgG + 0.114 * avgB;
      const textHex = bgLum < 130 ? '#F8FAFC' : '#0F172A';
      const accentHex = rgbToHex(accR, accG, accB);

      document.getElementById('cpBg').value = bgHex;
      document.getElementById('cpText').value = textHex;
      document.getElementById('cpAccent').value = accentHex;
      currentCustomMood = bgLum < 130
        ? '업로드된 이미지 기반의 깊이감 있는 다크 톤 & 고대비 포인트 스타일'
        : '업로드된 이미지 기반의 산뜻하고 조화로운 라이트 톤 & 포인트 스타일';

      document.getElementById('uploadThumb').src = ev.target.result;
      document.getElementById('uploadFileName').textContent = file.name + ' 색상 추출 완료';
      document.getElementById('extractedSwatches').innerHTML = [
        { lbl: '배경', hex: bgHex },
        { lbl: '텍스트', hex: textHex },
        { lbl: '포인트', hex: accentHex }
      ].map(s => `<span class="ex-swatch"><span class="ex-dot" style="background:${s.hex}"></span>${s.lbl} ${s.hex}</span>`).join('');
      document.getElementById('uploadPreviewWrap').classList.add('show');

      updateCustomStyle(true);
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}

