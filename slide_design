function escapeHtml(text) {
  return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}



function showToast(msg) {
  const t = document.getElementById('naiaToast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2100);
}

function copyTextSafe(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
  }
  return Promise.resolve(fallbackCopy(text));
}

function fallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.left = '-9999px';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  document.body.removeChild(ta);
}

function copyPrompt(index, btn) {
  const el = document.getElementById('pt-' + index);
  copyTextSafe(el.innerText).then(() => {
    const orig = btn.innerHTML;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 복사됨';
    btn.classList.add('copied');
    showToast('슬라이드 프롬프트가 복사되었습니다.');
    setTimeout(() => {
      btn.innerHTML = orig;
      btn.classList.remove('copied');
    }, 2000);
  });
}

function copyInfoG(index, btn) {
  const el = document.getElementById('pt-' + index);
  const originalPrompt = el.innerText;
  const infogPrompt = convertToInfoGraphicPrompt(originalPrompt);

  copyTextSafe(infogPrompt).then(() => {
    const orig = btn.innerHTML;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 복사됨';
    btn.classList.add('copied');
    showToast('인포그래픽(InfoG) 프롬프트가 복사되었습니다.');
    setTimeout(() => {
      btn.innerHTML = orig;
      btn.classList.remove('copied');
    }, 2000);
  });
}

function convertToInfoGraphicPrompt(original) {
  const roleMatch = original.match(/Role\s*[:\：]\s*(.+)/);
  const industryMatch = original.match(/Industry\s*[:\：]\s*(.+)/);
  const typeMatch = original.match(/Type\s*[:\：]\s*(.+)/);
  const bgMatch = original.match(/Background\s*[:\：]\s*(.+)/);
  const accentMatch = original.match(/Accent\s*[:\：]\s*(.+)/);
  const fontMatch = original.match(/Font\s*[:\：]\s*(.+)/);
  const toneMatch = original.match(/\[Tone[^\]]*\]\s*([\s\S]*?)(?=\[|$)/);

  const role = roleMatch ? roleMatch[1].trim() : '';
  const industry = industryMatch ? industryMatch[1].trim() : '';
  const type = typeMatch ? typeMatch[1].trim() : '';
  const bg = bgMatch ? bgMatch[1].trim() : '';
  const accent = accentMatch ? accentMatch[1].trim() : '';
  const font = fontMatch ? fontMatch[1].trim() : '';
  const toneBlock = toneMatch ? toneMatch[1].trim().split('\n')[0].trim() : '';

  return `[NotebookLM Infographic Design Guide]

Role : ${role}
Industry : ${industry}
Content Type : 인포그래픽 (단일 페이지 시각화 자료)

[Infographic Purpose]
복잡한 정보를 한눈에 파악할 수 있도록 데이터, 흐름, 관계를 시각적으로 정리한 인포그래픽

[Color Guide]
Background : ${bg}
Accent : ${accent}
Font : ${font}

[Layout Structure]
- 상단 : 메인 제목 + 핵심 인사이트 1문장
- 중단 : 3~5개 핵심 데이터 블록 또는 플로우 다이어그램
- 하단 : 출처, 날짜, 브랜드 정보

[Visual Elements]
- 아이콘, 픽토그램, 차트(바/파이/라인) 적극 활용
- 숫자/수치는 크고 굵게 강조
- 화살표·연결선으로 흐름과 관계 표현
- 색상 블록으로 섹션 구분

[Tone & Manner]
${toneBlock}
명확하고 직관적인 정보 전달. 텍스트 최소화, 시각적 요소 극대화.

[Design Rules]
- 텍스트 비율 30% 이하, 비주얼 요소 70% 이상
- 여백 충분히 확보, 정보 과부하 지양
- 일관된 아이콘 스타일 (선형 또는 단색 면형 중 택1)
- 핵심 수치는 타이포그래피로 강조 (숫자 크게)

Source : ${type}

Apply this infographic style for a visually compelling, information-rich single-page design.`;
}

