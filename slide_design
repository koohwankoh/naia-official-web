// ── SEARCH ─────────────────────────────────────────────
let searchOpen = false;

function toggleSearch() {
  searchOpen = !searchOpen;
  const wrap = document.getElementById('searchBarWrap');
  const btn  = document.getElementById('searchToggleBtn');
  const resList = document.getElementById('searchResultsList');
  wrap.classList.toggle('open', searchOpen);
  btn.classList.toggle('active', searchOpen);
  if (searchOpen) {
    document.getElementById('searchInput').focus();
  } else {
    clearSearch();
    resList.classList.remove('open');
    resList.innerHTML = '';
  }
}

function clearSearch() {
  const inp = document.getElementById('searchInput');
  const clearBtn = document.getElementById('searchClearBtn');
  const resList = document.getElementById('searchResultsList');
  const scroll  = document.getElementById('sidebarScroll');
  inp.value = '';
  clearBtn.classList.remove('visible');
  resList.classList.remove('open');
  resList.innerHTML = '';
  scroll.style.display = '';
}

function highlight(text, query) {
  if (!query) return text;
  const re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
  return text.replace(re, '<span class="sri-highlight">$1</span>');
}

function onSearchInput(val) {
  const clearBtn = document.getElementById('searchClearBtn');
  const resList  = document.getElementById('searchResultsList');
  const scroll   = document.getElementById('sidebarScroll');
  const query    = val.trim();

  clearBtn.classList.toggle('visible', query.length > 0);

  if (!query) {
    resList.classList.remove('open');
    resList.innerHTML = '';
    scroll.style.display = '';
    return;
  }

  // 전체 업종 검색
  const matches = [];
  categories.forEach(cat => {
    cat.industries.forEach(ind => {
      if (ind.includes(query) || cat.name.includes(query)) {
        matches.push({ cat, industry: ind });
      }
    });
  });

  scroll.style.display = 'none';
  resList.classList.add('open');

  if (matches.length === 0) {
    resList.innerHTML = `<div class="search-no-result">😢 "<strong>${query}</strong>" 검색 결과 없음</div>`;
    return;
  }

  resList.innerHTML = matches.map((m, i) => `
    <button class="search-result-item" id="sri-${i}" onclick="selectSearchResult(${i})">
      <span class="sri-industry">${highlight(m.industry, query)}</span>
      <span class="sri-category">${m.cat.emoji} ${highlight(m.cat.name, query)}</span>
    </button>
  `).join('');

  // 결과를 전역 저장 (클릭 시 사용)
  window._searchMatches = matches;
}

function selectSearchResult(idx) {
  const m = window._searchMatches[idx];
  if (!m) return;

  // 활성 표시
  document.querySelectorAll('.search-result-item').forEach(el => el.classList.remove('active'));
  const el = document.getElementById('sri-' + idx);
  if (el) el.classList.add('active');

  // 기존 사이드바도 해당 카테고리 열기 (선택 상태 동기화)
  const scroll = document.getElementById('sidebarScroll');
  const lists  = scroll.querySelectorAll('.industry-list');
  const catBtns = scroll.querySelectorAll('.category-btn');
  const indBtns = scroll.querySelectorAll('.industry-btn');

  lists.forEach(l => l.classList.remove('open'));
  catBtns.forEach(b => b.classList.remove('active'));
  indBtns.forEach(b => b.classList.remove('active'));

  const targetList = document.getElementById('list-' + m.cat.id);
  const targetCatBtn = targetList ? targetList.previousElementSibling : null;
  if (targetList) targetList.classList.add('open');
  if (targetCatBtn) targetCatBtn.classList.add('active');

  // 해당 업종 버튼 활성화
  indBtns.forEach(b => {
    if (b.textContent.trim().replace(/^·\s*/, '') === m.industry || b.innerText.trim().includes(m.industry)) {
      b.classList.add('active');
    }
  });

  // 프롬프트 렌더
  selectIndustry(m.cat, m.industry, document.createElement('button'));
}
