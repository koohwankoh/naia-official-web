let activeCategory = null;
let activeIndustry = null;

const sidebar = document.getElementById('sidebarScroll');
const contentArea = document.getElementById('contentArea');
const welcomeScreen = document.getElementById('welcomeScreen');
const promptArea = document.getElementById('promptArea');

// Build sidebar
categories.forEach((cat) => {
  const group = document.createElement('div');
  group.className = 'category-group';

  const btn = document.createElement('button');
  btn.className = 'category-btn';
  btn.innerHTML = `
    <span class="cat-emoji">${cat.emoji}</span>
    <span class="cat-info">
      <span class="cat-name">${cat.name}</span>
      <span class="cat-count">${cat.industries.length}개 업종</span>
    </span>
    <span class="cat-chevron">▶</span>
  `;
  btn.addEventListener('click', () => toggleCategory(cat.id, btn, list));

  const list = document.createElement('div');
  list.className = 'industry-list';
  list.id = 'list-' + cat.id;

  cat.industries.forEach((industry) => {
    const iBtn = document.createElement('button');
    iBtn.className = 'industry-btn';
    iBtn.innerHTML = `<span class="industry-dot"></span>${industry}`;
    iBtn.addEventListener('click', () => selectIndustry(cat, industry, iBtn));
    list.appendChild(iBtn);
  });

  group.appendChild(btn);
  group.appendChild(list);
  sidebar.appendChild(group);
});

function toggleCategory(catId, btn, list) {
  const isOpen = list.classList.contains('open');
  // Close all
  document.querySelectorAll('.industry-list').forEach(l => l.classList.remove('open'));
  document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
  if (!isOpen) {
    list.classList.add('open');
    btn.classList.add('active');
    activeCategory = catId;
  } else {
    activeCategory = null;
  }
}

function selectIndustry(cat, industry, iBtn) {
  // Active states
  document.querySelectorAll('.industry-btn').forEach(b => b.classList.remove('active'));
  iBtn.classList.add('active');
  activeIndustry = industry;

  // Show prompts
  welcomeScreen.style.display = 'none';
  promptArea.style.display = 'block';
  renderPrompts(cat, industry);
}

